{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "golukituki",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ENV": "local",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "golukituki-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
    },
  ],
  "env": {
    "production": {
      "name": "golukituki",
      "vars": {
        "APP_ENV": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "golukituki-production",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "../../migrations",
        },
      ],
    },
    "preview": {
      "name": "golukituki-preview",
      "vars": {
        "APP_ENV": "preview",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "golukituki-preview",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "../../migrations",
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
