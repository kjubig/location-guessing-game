{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "golukituki",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ENV": "local",
  },
  "ratelimits": [
    {
      "name": "GAME_CREATION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "golukituki-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
    },
  ],
  "env": {
    "production": {
      "name": "golukituki",
      "vars": {
        "APP_ENV": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "golukituki-production",
          "database_id": "0eaa0361-74af-44fc-b3c5-cdc8c87f0445",
          "migrations_dir": "../../migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "GAME_CREATION_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
    },
    "preview": {
      "name": "golukituki-preview",
      "vars": {
        "APP_ENV": "preview",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "golukituki-preview",
          "database_id": "aef549a4-1288-4026-ab75-baf3ed48fd33",
          "migrations_dir": "../../migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "GAME_CREATION_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
