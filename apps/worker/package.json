{
  "name": "@golukituki/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --env production",
    "deploy:preview": "wrangler versions upload --env preview",
    "deploy:production": "wrangler deploy --env production",
    "dev": "wrangler dev --local --port 8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply golukituki-local --local",
    "db:migrate:preview": "wrangler d1 migrations apply golukituki-preview --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply golukituki-production --remote --env production"
  },
  "dependencies": {
    "@golukituki/core": "workspace:*",
    "hono": "^4.9.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.36.0"
  }
}
