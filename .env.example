# Browser-visible values must use the VITE_ prefix.
# Leave blank in local development to use the Vite /api proxy.
VITE_API_BASE_URL=

# Server-only credentials are stored in apps/worker/.dev.vars locally and as
# Cloudflare secrets remotely. Never put them in this file for real deployments.
TURNSTILE_SECRET_KEY=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
